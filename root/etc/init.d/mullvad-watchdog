#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/mullvad/watchdog.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mullvad"
}

reload_service() {
	restart
}
